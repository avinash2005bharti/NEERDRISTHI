# ==============================================================================
# ORCA / NEERDRISTHI Frontend (React / Vite) — Environment Configuration
# ==============================================================================
# Local Development (Default):
# - Leave VITE_API_URL empty if using Vite dev proxy (vite.config.ts proxies /api -> http://localhost:3001)
# - Leave VITE_SOCKET_URL empty or set to http://localhost:3001
#
# Render Production Deployment (Static Site):
# - VITE_API_URL=https://orca-backend.onrender.com
# - VITE_SOCKET_URL=https://orca-backend.onrender.com

# Base API endpoint for backend REST requests
VITE_API_URL=

# WebSocket server URL for real-time telemetry (Socket.IO /orca namespace)
VITE_SOCKET_URL=

# Optional Mapbox Access Token for satellite basemap tiles
VITE_MAPBOX_ACCESS_TOKEN=
