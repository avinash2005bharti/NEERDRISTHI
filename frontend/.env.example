# ==============================================================================
# NEERDRISTHI Frontend (React / Vite) — Environment Configuration Template
# ==============================================================================
# In local development, Vite proxies /api and /socket.io directly to http://localhost:3001.
# Copy this file to .env if you need to override the backend gateway URL.

# Base API endpoint for REST requests (Default: empty, uses Vite proxy /api/v1)
VITE_API_URL=

# WebSocket server URL for real-time telemetry (Default: http://localhost:3001)
VITE_SOCKET_URL=http://localhost:3001

# Optional Mapbox Access Token if using Mapbox GL satellite tiles
VITE_MAPBOX_ACCESS_TOKEN=
