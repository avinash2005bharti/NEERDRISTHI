# ==============================================================================
# ORCA API Gateway — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in required values locally.
# NEVER commit real credentials to git.

NODE_ENV=development
# Port to listen on (Render automatically injects PORT=10000; defaults to 3001 locally)
PORT=3001
GATEWAY_PORT=3001

# Comma-separated list of allowed client CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://orca-frontend-55rq.onrender.com
# Deployed frontend URL (Render Static Site URL, e.g. https://orca-frontend-55rq.onrender.com)
FRONTEND_URL=https://orca-frontend-55rq.onrender.com

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/orca
MONGODB_URI=
MONGODB_DB_NAME=orca

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ── FastAPI Agent Core ────────────────────────────────────────────────────────
# Local: http://localhost:8000
# Render Web Service: https://orca-aiservices.onrender.com
AI_SERVICE_URL=https://orca-aiservices.onrender.com
FASTAPI_INTERNAL_URL=https://orca-aiservices.onrender.com
# Must match INTERNAL_SERVICE_SECRET in backend/ai-services/.env
INTERNAL_SERVICE_SECRET=

# ── Logging & Rate Limiting ───────────────────────────────────────────────────
LOG_LEVEL=info
# 900000ms = 15 minutes
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
