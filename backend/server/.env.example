# ORCA API Gateway — Environment Configuration
# Copy this file to .env and fill in required secrets.
# NEVER commit .env to git.

NODE_ENV=development
GATEWAY_PORT=3001
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local: mongodb://localhost:27017
# Docker: mongodb://mongodb:27017
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/orca
MONGODB_URI=
MONGODB_DB_NAME=orca

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ── FastAPI Agent Core ────────────────────────────────────────────────────────
# Local: http://localhost:8000
# Docker: http://agent-core:8000
FASTAPI_INTERNAL_URL=http://localhost:8000
# Must match INTERNAL_SERVICE_SECRET in apps/agent-core/.env
INTERNAL_SERVICE_SECRET=<generate_with: openssl rand -hex 32>

# ── Logging & Rate Limiting ───────────────────────────────────────────────────
LOG_LEVEL=info
# 900000ms = 15 minutes
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
