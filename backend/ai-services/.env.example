# ==============================================================================
# ORCA Agent Core (Python FastAPI) — Environment Configuration Template
# SMART INDIA HACKATHON SIH26176: Marine Ecosystem Reasoning with Collaborative AI
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit .env to git. All credentials and keys must remain strictly confidential.
# - This template contains PLACEHOLDERS ONLY. Fill in your secrets locally.
# - Any previously exposed credentials MUST be rotated immediately.
# ==============================================================================

APP_ENV=development
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
LOG_LEVEL=INFO

# ── Shared Internal Secrets ───────────────────────────────────────────────────
INTERNAL_SERVICE_SECRET=your_internal_gateway_secret_here
JWT_SECRET=your_jwt_secret_here

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=orca

# ── Groq LLM (Explainable Synthesis) ──────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0
GROQ_MAX_TOKENS=2048
GROQ_TIMEOUT_SECONDS=30

# ── Qdrant Cloud (Semantic Long-Term Memory) ──────────────────────────────────
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_MEMORY=orca_memory
QDRANT_COLLECTION_KNOWLEDGE=orca_knowledge

# ── Vector Embeddings ─────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ==============================
# WEATHER
# ==============================
WEATHER_PROVIDER=open_meteo
WEATHER_BASE_URL=https://api.open-meteo.com
WEATHER_FORECAST_ENDPOINT=/v1/forecast
WEATHER_API_KEY=

MET_NO_ENABLED=true
MET_NO_BASE_URL=https://api.met.no
MET_NO_ENDPOINT=/weatherapi/locationforecast/2.0/complete
MET_NO_USER_AGENT=ORCA-SIH26176-Hackathon/1.0 (contact: student-team@sih26176.in)

# ==============================
# MARINE
# ==============================
MARINE_PROVIDER=open_meteo
MARINE_BASE_URL=https://marine-api.open-meteo.com
MARINE_ENDPOINT=/v1/marine
MARINE_API_KEY=

# ==============================
# INCOIS ERDDAP
# ==============================
INCOIS_ERDDAP_ENABLED=true
INCOIS_ERDDAP_BASE_URL=https://erddap.incois.gov.in/erddap

# Official INCOIS API (Optional / Institutional only)
INCOIS_OFFICIAL_ENABLED=false
INCOIS_BASE_URL=
INCOIS_API_KEY=
INCOIS_PFZ_ENDPOINT=/pfz
INCOIS_OCEAN_STATE_ENDPOINT=/osf

# ==============================
# COPERNICUS MARINE
# ==============================
COPERNICUS_ENABLED=false
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# ==============================
# TIDES
# ==============================
TIDE_PROVIDER=open_meteo
WORLDTIDES_ENABLED=false
WORLDTIDES_API_KEY=

# ==============================
# GEOCODING
# ==============================
GEOCODER_PROVIDER=nominatim
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_ENDPOINT=/search
GEOCODER_API_KEY=
GEOCODER_USER_AGENT=ORCA-SIH26176-Hackathon/1.0 (contact: student-team@sih26176.in; marine safety project)
GEOCODER_RATE_LIMIT_PER_SECOND=1

# ==============================
# ALERTS & CYCLONES
# ==============================
ALERT_PROVIDER=gdacs
ALERT_BASE_URL=https://www.gdacs.org

# ==============================
# PROVIDER RUNTIME & CACHE
# ==============================
ENABLE_PROVIDER_FALLBACK=true
PROVIDER_TIMEOUT_SECONDS=15
EXTERNAL_RETRY_ATTEMPTS=2
MAX_DATA_FRESHNESS_MINUTES=360
REQUEST_TIMEOUT_SECONDS=15
VALKEY_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=900
DEMO_MODE=true
MARINE_DEMO_MODE=true

# ==============================
# HD MARINE MAP ARCHITECTURE
# ==============================
MAP_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
ISRO_API_BASE_URL=
ISRO_API_KEY=
